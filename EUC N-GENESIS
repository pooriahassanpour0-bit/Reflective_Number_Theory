-- 2–5. LinearOrder Literal & Clause — ۴ تا sorry پر شد
-- =====================================================================

instance {m : ℕ} : LinearOrder (Literal m) where
  le           := fun a b => a.v < b.v ∨ (a.v = b.v ∧ a.pos ≤ b.pos)
  le_refl a     := Or.inr ⟨rfl, le_rfl⟩
  le_trans a b c := by
    simp [le]; tauto
  le_antisymm a b := by
    simp [le]; rintro (h | h) <;> simp [*]
  le_total a b  := by
    by_cases h : a.v < b.v <;> simp [le, h, not_lt_of_gt]
  decidableLE   := inferInstance

instance {m : ℕ} : LinearOrder (Clause m) where
  le           := fun a b => a.lits.sort (· ≤ ·) ≤ b.lits.sort (· ≤ ·)
  le_refl       := by simp
  le_trans      := by apply List.Lex.le_trans
  le_antisymm a b h1 h2 := by
    simp [le] at h1 h2
    exact Finset.sort_eq_sort.mp (le_antisymm h1 h2)
  le_total     := List.Lex.le_total
  decidableLE  := inferInstance

